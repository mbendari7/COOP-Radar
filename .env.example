# OPTIONAL settings for `python start.py`. The site works without this file.
# To use it: copy it to .env (never commit .env, it's in .gitignore) and fill in what you need.
# On a host (Render, Railway, ...) set these in the host's "Environment" settings instead.

# --- Database (optional on your own computer) ----------------------------------------
# Empty = start.py runs a private PostgreSQL for you in the .coopradar folder in your home folder.
# To use a cloud database instead (Neon, Supabase, Render...), paste its connection URL here.
# Any of these formats work: postgres://..., postgresql://..., ?sslmode=require
# DATABASE_URL=postgresql://user:password@host:5432/coopradar

# --- Redis (optional) -----------------------------------------------------------------
# Empty = login sessions and rate limits are stored in PostgreSQL. Set a redis:// URL to
# keep them in Redis instead (faster under heavy traffic).
# REDIS_URL=redis://localhost:6379/0

# --- AI providers (ALL OPTIONAL) -------------------------------------------------------
# Visitors bring their OWN key (Claude, ChatGPT, or Gemini) on the site's "AI key" page,
# so you can leave both of these empty and pay nothing. Set them only if you want to:
#   ANTHROPIC_API_KEY  lets visitors WITHOUT a key use AI on your account (AI_DAILY_LIMIT applies)
#   OPENAI_API_KEY     turns on smart (meaning-based) search and "similar postings" (cheap embeddings)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models used with YOUR Anthropic key above (visitors pick their own model on the AI key page).
# AGENT_MODEL answers resume Q&A; FAST_MODEL ranks matches. EMBED_MODEL must output 1536-dim vectors.
AGENT_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5
EMBED_MODEL=text-embedding-3-small

# --- Public hosting --------------------------------------------------------------------
# "Try the demo" and "Upload without an account": private temporary accounts, deleted after
# 7 days unless the visitor saves them with an email + password.
DEMO_ENABLED=true
# AI actions per user per day on YOUR key (visitors' own keys are never limited). 0 = unlimited.
AI_DAILY_LIMIT=20
# Postgres cancels any single query that runs longer than this (ms), so requests fail fast.
DB_STATEMENT_TIMEOUT_MS=10000
# Session cookies are Secure (HTTPS-only) on a host; start.py turns this off on your own computer.
# COOKIE_SECURE=true
# Comma-separated origins allowed to call the API with cookies (only needed if the website
# and API live on different domains).
# CORS_ORIGINS=http://localhost:5173

# --- Jobs data -------------------------------------------------------------------------
# What gets loaded at start (true/false):
#   SEED_JOB_BOARDS       real employers' public career boards (backend/seed/job_boards.py)
#   SEED_SAMPLE_POSTINGS  about 55 made up postings, handy offline
#   SEED_DEV_SOURCES      two fixture-file sources for trying the Admin page
SEED_JOB_BOARDS=true
SEED_SAMPLE_POSTINGS=false
SEED_DEV_SOURCES=false
# Set to false to skip loading data at start.
SEED_ON_START=true
# How often each career board is re-imported, in hours.
INGEST_INTERVAL_HOURS=6
# Which career-board jobs to keep, as a regex on the job's location. Empty = the built-in
# Canada filter (Canada, Canadian provinces, major cities, "Remote - Canada"); .* = everywhere.
# Example, Ontario only:  INGEST_LOCATION_FILTER=Ontario|(?-i:\bON\b)|Toronto|Waterloo|Ottawa
INGEST_LOCATION_FILTER=
# US jobs: students = only co-op / intern / student / new-grad roles (default), all, or none.
INGEST_US_JOBS=students
# Optional and paid: Adzuna job search API (https://developer.adzuna.com). When both are set,
# CoopRadar also imports co-op, intern and student jobs Adzuna gathers from employer sites in
# every field. Not needed: Workable's free job search and the discovered career boards
# (seed/discover_boards.py) already bring in thousands of small employers. Leave empty to skip it.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
