# Copy this file to .env and fill in your values.
# Never commit .env — it's in .gitignore.

# --- PostgreSQL ---
POSTGRES_USER=coopradar
POSTGRES_PASSWORD=changeme
POSTGRES_DB=coopradar

# Full async connection URL consumed by SQLAlchemy and Alembic.
# The docker-compose.yml constructs this from the three vars above;
# override here if you're running the backend outside Docker.
DATABASE_URL=postgresql+asyncpg://coopradar:changeme@localhost:5432/coopradar

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
# Comma-separated list of origins the API allows CORS requests from.
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# The URL the browser uses to reach the FastAPI backend.
# In Docker Compose dev mode the Vite proxy handles this; set it explicitly
# when running the frontend outside Docker.
VITE_API_URL=http://localhost:8000
