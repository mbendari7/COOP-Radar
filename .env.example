# Copy this file to .env and fill in your values:   cp .env.example .env
# Never commit .env — it's in .gitignore.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=coopradar
POSTGRES_PASSWORD=changeme
POSTGRES_DB=coopradar

# Full async connection URL used by the API, the worker, and Alembic.
# docker-compose.yml builds its own from the three vars above; this one is for
# running the backend outside Docker (Postgres exposed on localhost:5432).
DATABASE_URL=postgresql+asyncpg://coopradar:changeme@localhost:5432/coopradar

# --- Redis (sessions, rate limits, job queue) ---------------------------------
REDIS_URL=redis://localhost:6379/0

# --- API -----------------------------------------------------------------------
# Comma-separated origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173
# Session cookies are Secure by default (http://localhost still works in browsers).
# Only set this to false for non-browser clients; the test suite does it automatically.
# COOKIE_SECURE=true

# --- AI providers (ALL OPTIONAL) ---------------------------------------------------
# Visitors bring their OWN key (Claude, ChatGPT, or Gemini) on the site's "AI key" page,
# so you can leave both of these empty and pay nothing. Set them only if you want to:
#   ANTHROPIC_API_KEY — let visitors WITHOUT a key use AI on your account (AI_DAILY_LIMIT applies)
#   OPENAI_API_KEY    — turn on smart (meaning-based) search and "similar postings" (cheap embeddings)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models used with YOUR Anthropic key above (visitors pick their own model on the AI key page).
# AGENT_MODEL answers resume Q&A; FAST_MODEL ranks matches. EMBED_MODEL must output 1536-dim vectors.
AGENT_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5
EMBED_MODEL=text-embedding-3-small

# --- Public hosting ----------------------------------------------------------------
# "Try the demo" and "Upload without an account": private temporary accounts, deleted after
# 7 days unless the visitor saves them with an email + password.
DEMO_ENABLED=true
# AI actions per user per day on YOUR key (visitors' own keys are never limited). 0 = unlimited.
AI_DAILY_LIMIT=20
# Postgres cancels any single query that runs longer than this (ms), so requests fail fast.
DB_STATEMENT_TIMEOUT_MS=10000
# docker-compose.prod.yml only: run the seed on start (safe to repeat), port, and HTTPS domain.
SEED_ON_START=true
APP_PORT=8080
# DOMAIN=coopradar.example.com

# --- Jobs data ---------------------------------------------------------------------
# What `python -m seed` loads (each true/false):
#   SEED_JOB_BOARDS       real employers' public career boards (backend/seed/job_boards.py)
#   SEED_SAMPLE_POSTINGS  ~55 made-up postings — handy offline; the prod configs turn it off
#   SEED_DEV_SOURCES      two fixture-file sources for trying the Admin page
SEED_JOB_BOARDS=true
SEED_SAMPLE_POSTINGS=true
SEED_DEV_SOURCES=true
# How often each enabled source is re-fetched by the worker.
INGEST_INTERVAL_HOURS=6
# Which career-board jobs to keep, as a regex on the job's location. Empty = the built-in
# Canada filter (Canada, Canadian provinces, major cities, "Remote - Canada"); .* = everywhere.
# Example, Ontario only:  INGEST_LOCATION_FILTER=Ontario|(?-i:\bON\b)|Toronto|Waterloo|Ottawa
INGEST_LOCATION_FILTER=

# --- Frontend --------------------------------------------------------------------
# Leave VITE_API_URL empty to call /api through the Vite dev proxy (recommended —
# keeps cookies first-party). Set it only when the API lives on another origin.
VITE_API_URL=
# Where the Vite dev server proxies /api. docker-compose sets http://api:8000.
API_PROXY_TARGET=http://localhost:8000
