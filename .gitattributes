# Force LF line endings for all text files regardless of OS.
# Prevents CRLF noise in diffs on Windows machines.

* text=auto eol=lf

# Explicitly binary — never mangle these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
*.gz   binary

# Python
*.py   text eol=lf diff=python
*.pyi  text eol=lf diff=python

# JavaScript / TypeScript
*.js   text eol=lf diff=javascript
*.jsx  text eol=lf diff=javascript
*.ts   text eol=lf diff=javascript
*.tsx  text eol=lf diff=javascript
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf diff=html

# Config files
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.ini  text eol=lf
*.cfg  text eol=lf
*.env.example text eol=lf
*.md   text eol=lf diff=markdown
*.sql  text eol=lf
*.sh   text eol=lf

# Docker
Dockerfile   text eol=lf
*.dockerignore text eol=lf
